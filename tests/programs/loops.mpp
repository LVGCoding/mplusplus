total := 0
for i \in 1..100 \{
    total \leftarrow total + i
\}
print("sum:", total)
for k in 10..-3..1 \{ print(k) \}
for t \in 0..0.25..1 \{ print(t) \}
n := 0
while true \{
    n \leftarrow n + 1
    if n mod 2 = 0 \{ continue \}
    if n > 7 \{ break \}
    print(n)
\}
grade(score) \{
    if score \geq 90 \{
        return "A"
    \} else if score \geq 80 \{
        return "B"
    \}
    else \{
        return "C"
    \}
\}
print(grade(95), grade(85), grade(10))
greet(name) \{ print("hello", name) \}
greet("world")
square(x) := x \cdot x
print(square(3), square(1.5))
